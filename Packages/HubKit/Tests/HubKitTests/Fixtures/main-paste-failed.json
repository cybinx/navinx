{
  "v": 1,
  "id": "main",
  "title": "Add",
  "tab": {
    "title": "Add",
    "symbol": "dot.radiowaves.left.and.right"
  },
  "sections": [
    {
      "id": "mode",
      "card": "none",
      "parts": [
        {
          "type": "choice",
          "id": "mode",
          "options": [
            {
              "id": "paste",
              "label": "Video"
            },
            {
              "id": "find",
              "label": "Catalog"
            }
          ],
          "value": "paste",
          "action": {
            "id": "mode",
            "sends": [
              "mode"
            ]
          },
          "large": true
        }
      ]
    },
    {
      "id": "link",
      "card": "glass",
      "parts": [
        {
          "type": "field",
          "id": "link",
          "placeholder": "Paste a Video link",
          "label": "Video link",
          "value": "https://example.com/bad",
          "paste": true,
          "keyboard": "url",
          "returnKey": "go",
          "submit": {
            "id": "check",
            "sends": [
              "link"
            ]
          },
          "button": {
            "id": "check",
            "label": "Check",
            "style": "prominent",
            "action": {
              "id": "check",
              "sends": [
                "link"
              ]
            },
            "needs": [
              "link"
            ]
          }
        }
      ]
    },
    {
      "id": "failed",
      "card": "glass",
      "parts": [
        {
          "type": "text",
          "id": "error",
          "text": "That isn't a Video link.",
          "style": "body",
          "symbol": "exclamationmark.triangle.fill",
          "tint": "red"
        },
        {
          "type": "button",
          "id": "startOver",
          "gap": 14,
          "label": "Start over",
          "style": "plain",
          "action": {
            "id": "startOver"
          }
        }
      ]
    },
    {
      "id": "session",
      "title": "This session",
      "gap": 28,
      "card": "glass",
      "parts": [
        {
          "type": "row",
          "id": "session-0",
          "title": "Artist Name - Song Title",
          "subtitle": "Added",
          "symbol": "checkmark.circle.fill",
          "tint": "green"
        }
      ]
    },
    {
      "id": "rescan",
      "gap": 14,
      "card": "glass",
      "parts": [
        {
          "type": "text",
          "id": "rescanHint",
          "text": "Rescan if a new song doesn't show up yet.",
          "style": "subhead"
        },
        {
          "type": "button",
          "id": "rescan",
          "gap": 10,
          "label": "Rescan library",
          "symbol": "arrow.triangle.2.circlepath",
          "style": "prominent",
          "action": {
            "id": "rescan"
          }
        }
      ]
    }
  ]
}
