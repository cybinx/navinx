          "symbol": "info.circle"
        }
      ]
    },
    {
      "id": "invite",
      "title": "Invite",
      "card": "glass",
      "parts": [
        {
          "type": "field",
          "id": "inviteUser",
          "placeholder": "Username",
          "label": "Username",
          "value": "",
          "paste": false,
          "keyboard": "text",
          "returnKey": "go"
        },
        {
          "type": "choice",
          "id": "invitePlace",
          "gap": 12,
          "options": [
            {
              "id": "home",
              "label": "Home network"
            },
            {
              "id": "address",
              "label": "One address"
            },
            {
              "id": "anywhere",
              "label": "Anywhere"
            }
          ],
          "value": "home",
          "action": {
            "id": "place",
            "sends": [
              "invitePlace",
              "inviteUser",
              "inviteAddress"
            ]
          }
        },
        {
          "type": "text",
          "id": "invitePlaceNote",
          "gap": 8,
          "text": "The code works only from your home network.",
          "style": "caption"
        },
        {
          "type": "button",
          "id": "inviteSend",
          "gap": 12,
          "label": "Send invite",
          "style": "prominent",
          "action": {
            "id": "invite",
            "sends": [
              "inviteUser",
              "invitePlace",
              "inviteAddress"
            ]
          },
          "needs": [
            "inviteUser"
          ]
        },
        {
          "type": "text",
          "id": "inviteNote",
          "gap": 12,
          "text": "This demo sends no email: the code shows here and under Invites waiting. On a real server it goes by email to the address Navidrome holds for the user, and works once, within 24 hours.",
          "style": "caption"
        }
      ]
    },
